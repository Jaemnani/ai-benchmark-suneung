# ============================================================
# Mobile port (v1.0) — append to existing .env.example
# ============================================================

# RevenueCat — Webhook 검증용 (RevenueCat 콘솔 → Integrations → Webhooks)
REVENUECAT_WEBHOOK_SECRET=

# Firebase Cloud Messaging (iOS APNs도 FCM 통합 발송)
FCM_PROJECT_ID=
# service-account-*.json 전체를 base64로 인코딩한 값
# 예: cat service-account.json | base64 -w 0
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# (선택) Sentry RN 별도 DSN — 모바일 전용 환경
# SENTRY_DSN_MOBILE=
